# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# --- Google Vertex AI Gemini（与上方二选一；启用后 LLM_API_KEY 可留空）---
# 文档：https://cloud.google.com/vertex-ai/generative-ai/docs/migrate/openai/overview
# 本地：安装 gcloud 后执行 `gcloud auth application-default login`
# 模型名须带 google/ 前缀。示例：
#   Gemini 3.1 Flash（GA，Flash-Lite）：google/gemini-3.1-flash-lite
#   Gemini 3 Flash（preview）：google/gemini-3-flash-preview
# LLM_USE_VERTEX_AI=true
# VERTEX_AI_PROJECT_ID=your-gcp-project-id
# VERTEX_AI_LOCATION=us-central1
# （可选）使用 Google 文档中的全域 OpenAPI 根地址时设为 global：https://cloud.google.com/vertex-ai/generative-ai/docs/migrate/openai/examples
# VERTEX_AI_LOCATION=global
# LLM_MODEL_NAME=google/gemini-3.1-flash-lite
#
# Important: Leave LLM_BASE_URL unset (or注释掉百炼 DashScope)，否则 Vertex 仍会误用阿里云地址。
# 若必须手写 Vertex 端点（末尾无 /）：
# LLM_BASE_URL=https://us-central1-aiplatform.googleapis.com/v1/projects/PROJECT_ID/locations/us-central1/endpoints/openapi
# 非标 Vertex URL 时请设 LLM_VERTEX_USE_EXPLICIT_BASE_URL=true（极少用）

# ===== LangSmith（可选，追踪 OpenAI SDK 调用——本体/图谱等业务路径）=====
# 文档：https://docs.langchain.com/langsmith/trace-openai
# OASIS/camel-ai 并行模拟脚本不使用本仓库的 wrap，通常不会出现在 LangSmith。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=mirofish

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here