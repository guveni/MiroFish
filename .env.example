
# ===== LLM provider (pick exactly one block and uncomment) =====

# --- A) Google Vertex AI Gemini ---
# Docs: https://cloud.google.com/vertex-ai/generative-ai/docs/migrate/openai/overview
# Locally: install gcloud, then `gcloud auth application-default login`
# LLM_PROVIDER=vertex
# LLM_USE_VERTEX_AI=true
# VERTEX_AI_PROJECT_ID=your-gcp-project-id
# VERTEX_AI_LOCATION=us-central1
# LLM_MODEL_NAME=google/gemini-3.5-flash
#
# Manual Vertex OpenAI-compatible URL shape (rarely needed):
# LLM_BASE_URL=https://us-central1-aiplatform.googleapis.com/v1/projects/PROJECT_ID/locations/us-central1/endpoints/openapi
# LLM_VERTEX_USE_EXPLICIT_BASE_URL=true

# --- B) Local Ollama ---
# Prereq: `brew install ollama && ollama serve` then `ollama pull mistral-small:24b`
# Or run `npm run setup:ollama` for guided setup.
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=qwen2.5:32b-instruct-q4_K_M
# Optional override; default is http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- C) OpenAI-compatible (OpenAI, DashScope, Together, etc.) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# --- D) Azure OpenAI ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# ----- LLM output limits (optional) -----
# Large JSON steps (ontology, profiles). Gemini 3.x on Vertex may need >= 8192.
# LLM_JSON_MAX_TOKENS=8192
# LLM_CHAT_MAX_TOKENS=8192

# ----- Composer LLM (optional second LLM for final report writing) -----
# When REPORT_USE_COMPOSER=true, the Report Agent uses this LLM only for the
# final markdown of each section; the primary LLM still plans and calls tools.
# REPORT_USE_COMPOSER=true
# COMPOSER_LLM_PROVIDER=vertex
# COMPOSER_LLM_MODEL_NAME=google/gemini-3.5-flash
# COMPOSER_LLM_VERTEX_PROJECT_ID=your-gcp-project-id
# COMPOSER_LLM_VERTEX_LOCATION=us-central1
# COMPOSER_LLM_API_KEY=your-api-key-if-not-using-vertex
# COMPOSER_LLM_BASE_URL=override-base-url-if-not-using-vertex

# ----- Pipeline step retry (LLM / graph backend / web search, etc.) -----
# First failure plus up to PIPELINE_STEP_MAX_RETRIES more attempts (integer; default 2 => 3 tries total).
# PIPELINE_STEP_MAX_RETRIES=2
# PIPELINE_STEP_INITIAL_DELAY_SEC=1
# PIPELINE_STEP_MAX_DELAY_SEC=30
# PIPELINE_STEP_BACKOFF_FACTOR=2
# PIPELINE_STEP_JITTER=true

# ===== Web search (independent of LLM provider — pick one) =====

# --- A) Vertex Gemini + Google Search grounding ---
# Requires VERTEX_AI_PROJECT_ID + VERTEX_AI_LOCATION with ADC.
# WEB_SEARCH_PROVIDER=vertex_gemini
# GEMINI_WEB_SEARCH_MODEL=gemini-3.1-flash-lite
# GEMINI_WEB_SEARCH_MAX_QUERIES=5
# GEMINI_WEB_SEARCH_MAX_CHARS=25000
# GEMINI_WEB_SEARCH_MAX_OUTPUT_TOKENS=8192

# --- B) Keiro web search API ---
# Works with any LLM including Ollama. Docs: https://platform.keirolabs.cloud/docs
# WEB_SEARCH_PROVIDER=keiro
# KEIRO_API_KEY=your_keiro_api_key_here
# KEIRO_API_BASE_URL=https://kierolabs.space/api/v2
# KEIRO_SEARCH_ENDPOINT=/search/content
# KEIRO_MAX_RESULTS_PER_QUERY=10
# KEIRO_TIMEOUT_SEC=30

# --- C) Disable web search entirely ---
# WEB_SEARCH_PROVIDER=none

# ----- Report-side web search pre-fetch (optional) -----
# REPORT_PREFETCH_WEB_SEARCH=true
# REPORT_PREFETCH_MAX_QUERIES=4

# ----- Run ledger / checkpoints (SQLite; omit to skip persistence)
# MIROFISH_RUN_DB=/absolute/path/to/mirofish_runs.sqlite
# RESUME_FROM_CHECKPOINT=true

# ----- LangSmith (optional) -----
# Docs: https://docs.langchain.com/langsmith/trace-openai
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=mirofish
#
# LLM traces include LangSmith usage_metadata for token and cost columns.
# Vertex defaults to ls_provider=google_vertexai and normalizes google/... model
# ids for LangSmith pricing lookup. Override only for custom gateways/models:
# LANGSMITH_LS_PROVIDER=
# LANGSMITH_LS_MODEL_NAME=
#
# For models missing from LangSmith's pricing table, set manual billing rates
# here (USD per 1M tokens) or add custom model pricing in LangSmith Settings > Models:
# LLM_INPUT_USD_PER_1M=
# LLM_OUTPUT_USD_PER_1M=
# For Ollama (free, local): set both to 0.
# OASIS / camel-ai child processes typically do not use this repo's LangSmith tracing path.

# ----- Graph memory (Neo4j + Graphiti - default) -----
# Auto-started by `npm run dev`. Requires Docker.
# Omit GRAPH_BACKEND to use Neo4j (default).
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish-dev
NEO4J_DATABASE=neo4j
GRAPHITI_EMBEDDER=local
GRAPHITI_LOCAL_EMBEDDING_MODEL=Alibaba-NLP/gte-large-en-v1.5
# HuggingFace token for authenticated model downloads (suppresses rate-limit warnings).
# Create at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
# Device for HuggingFace embeddings (cpu, cuda, mps). Default: cpu.
# HF_EMBEDDER_DEVICE=cpu
# Suppress tokenizers fork warnings and leaked semaphore on Ctrl-C.
TOKENIZERS_PARALLELISM=false
GRAPHITI_BATCH_SIZE=10
GRAPHITI_RERANKER=auto
GRAPHITI_SEMAPHORE_LIMIT=10
# In-batch progress heartbeat while add_episode_bulk runs (seconds; default 90).
GRAPHITI_BATCH_HEARTBEAT_SECONDS=90
# Used when LLM_PROVIDER=vertex or GRAPHITI_EMBEDDER=vertex.
GRAPHITI_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GRAPHITI_GEMINI_EMBEDDING_DIM=1024

# ----- Simulation preparation throughput -----
# LLM worker cap for independent simulation config Agent batches. Agent batch
# size remains fixed in code to preserve output shape and prompt scope.
# SIM_CONFIG_MAX_WORKERS=8

# ----- Legacy Zep Cloud (opt-in) -----
# Set GRAPH_BACKEND=zep, run `cd backend && uv sync --extra zep`, and uncomment:
# ZEP_API_KEY=your_zep_api_key_here
# Free tier: https://app.getzep.com/

# ----- Optional "boost" LLM (second provider) -----
# Do not define these vars if you are not using boost.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
